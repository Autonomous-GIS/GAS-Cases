------MultipartBoundary--aUaTwpjCxNeE8CUanBrSVUtlthx67KDKrmcy6fp5dD----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: cid:css-04befb46-e5c2-4c4e-bd05-d4064ad62589@mhtml.blink

@charset "utf-8";

*, ::before, ::after { box-sizing: border-box; }

html, body { margin: 0px; padding: 0px; width: 100%; height: 100%; overflow=
: hidden; background: rgb(15, 23, 42); color: white; font-family: sans-seri=
f; }

.canvas { position: relative; width: 100%; height: 100vh; background: radia=
l-gradient(circle at left top, rgba(14, 165, 233, 0.14), transparent 30%), =
radial-gradient(circle at right bottom, rgba(249, 115, 22, 0.14), transpare=
nt 28%), rgb(30, 41, 59); overflow: hidden; }

.node { position: absolute; padding: 12px 14px; border-radius: 10px; border=
: 1px solid rgb(71, 85, 105); min-width: 160px; max-width: 220px; backgroun=
d: rgb(51, 65, 85); box-shadow: rgba(0, 0, 0, 0.35) 0px 8px 20px; cursor: g=
rab; }

.type-start { background: rgb(124, 58, 237); border-color: rgb(167, 139, 25=
0); }

.type-data { background: rgb(3, 105, 161); border-color: rgb(56, 189, 248);=
 }

.type-tool { background: rgb(51, 65, 85); border-color: rgb(71, 85, 105); }

.type-output { background: rgb(21, 128, 61); border-color: rgb(34, 197, 94)=
; }

.type-end { background: rgb(220, 38, 38); border-color: rgb(248, 113, 113);=
 }

.node-title { font-size: 12px; font-weight: 700; line-height: 1.35; margin-=
bottom: 4px; }

.node-subtitle { font-size: 10px; line-height: 1.4; color: rgba(255, 255, 2=
55, 0.75); }

.legend { position: absolute; bottom: 12px; right: 14px; display: flex; gap=
: 6px; flex-wrap: wrap; z-index: 10; }

.chip { padding: 4px 9px; border-radius: 999px; font-size: 10px; border: 1p=
x solid rgba(255, 255, 255, 0.14); background: rgba(15, 23, 42, 0.55); }
