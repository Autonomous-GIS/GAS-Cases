    "Teal":   {"fill": "#1ABC9C", "spine": "#D1F2EB", "tick": "#111111"},
}
chosen =3D random.choice(list(COLOR_SETS.values()))
FILL_COLOR =3D chosen["fill"]
SPINE_COL  =3D chosen["spine"]
TICK_COL   =3D chosen["tick"]

# =E2=94=80=E2=94=80 3. LOAD DATA =E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=
