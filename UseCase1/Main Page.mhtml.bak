igure osmnx settings.=20
# Instead of using ox.utils.config(use_cache=3DTrue, log_console=3DTrue), w=
e should configure settings directly using their attributes.
# The correct way to set these configurations is directly via the ox.settin=
gs property.

import os
import requests
import geopandas as gpd
import osmnx as ox

def download_data():
    # Set the application name for OpenStreetMap queries and configure logg=
ing and caching
    ox.settings.log_console =3D True
    ox.settings.use_cache =3D True
    ox.settings.log_name =3D "osmnx"
   =20
    # Define the place of interest
    place_name =3D "Richland County, South Carolina, USA"
   =20
    # Get the bounding box from OpenStreetMap
    gdf =3D ox.geocode_to_gdf(place_name)
    west, south, east, north =3D gdf.unary_union.bounds
   =20
    # Define OpenTopography API parameters
    api_key =3D "fea3af1b3b14f2d18a208f1cada484ce"
    dem_type =3D "SRTMGL1"  # SRTM GL1 provides 30m resolution data
    output_format =3D "GTiff"
   =20
    # Create the API request URL
    url =3D f"https://portal.opentopography.org/API/globaldem?demtype=3D{de=
m_type}" \
          f"&amp;south=3D{south}&amp;north=3D{north}&amp;west=3D{west}&amp;=
east=3D{east}" \
          f"&amp;outputFormat=3D{output_format}&amp;API_Key=3D{api_key}"
   =20
    # Request the DEM data
    response =3D requests.get(url)
   =20
    # Check if the request was successful
    response.raise_for_status()
   =20
    # Define the output path
    output_dir =3D "/home/abk6234/GAS/mysite2/Data"
    os.makedirs(output_dir, exist_ok=3DTrue)
    output_file =3D os.path.join(output_dir, "richland_county_sc_dem_667377=
.tif")
   =20
    # Save the DEM data to a file
    with open(output_file, 'wb') as file:
        file.write(response.content)
   =20
    print(f"DEM data saved to {output_file}")

download_data()</code></pre></div><div class=3D"px-4 py-2 bg-[#252525] bord=
