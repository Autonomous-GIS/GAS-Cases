=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
crs =3D points_gdf.crs
if crs.is_geographic:
    x_label =3D "Longitude (degrees)"
    y_label =3D "Latitude (degrees)"
else:
    try:
        axes =3D crs.axis_info
        x_label =3D f"{axes[0].name} ({axes[0].unit_name})"
        y_label =3D f"{axes[1].name} ({axes[1].unit_name})"
    except:
        x_label =3D "X"
        y_label =3D "Y"

crs_epsg =3D crs.to_epsg()
crs_str =3D f"EPSG:{crs_epsg}" if crs_epsg else getattr(crs, 'name', 'Unkno=
wn CRS')
