# Function to generate random points within a given polygon
def generate_random_points_within_polygon(polygon, num_points):
    min_x, min_y, max_x, max_y =3D polygon.bounds
    points =3D []
    while len(points) &lt; num_points:
        random_point =3D Point(random.uniform(min_x, max_x), random.uniform=
(min_y, max_y))
        if polygon.contains(random_point):
            points.append(random_point)
    return points

# Extract the polygon boundary of Richland County
richland_polygon =3D richland_gdf.geometry.iloc[0]

# Generate 100 random points within Richland County
random_points =3D generate_random_points_within_polygon(richland_polygon, 1=
00)

# Create a GeoDataFrame from the random points
points_gdf =3D gpd.GeoDataFrame(geometry=3Drandom_points, crs=3Drichland_gd=
f.crs)

# Output the generated points
print(points_gdf.head())</code></pre></div><div class=3D"px-4 py-2 bg-[#252=
