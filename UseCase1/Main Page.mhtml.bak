@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=3DInter:wght@400;500;=
600;700&family=3DJetBrains+Mono:wght@400;500&display=3Dswap");

@layer properties {
  @supports (((-webkit-hyphens:none)) and (not (margin-trim:inline))) or ((=
