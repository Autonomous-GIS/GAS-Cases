 class=3D"p-4 text-[13px] font-mono text-neutral-300 overflow-x-auto leadin=
g-relaxed transition-all duration-300"><code>import os
import geopandas as gpd

def download_data():
    # Define the URL for downloading Richland County, SC boundary from the =
Census Bureau
    base_url =3D "https://www2.census.gov/geo/tiger/GENZ2021/shp/"
    # Year of data
    year =3D 2021
    # State FIPS for South Carolina is 45 and the county FIPS for Richland =
County is 079
    file_name =3D f"cb_{year}_us_county_500k.zip"
    url =3D base_url + file_name

    # Define the output directory and file name
    output_directory =3D "/home/abk6234/GAS/mysite2/Data"
    output_file_stem =3D "richland_county_boundary_south_carolina_142777"

    # Read the zip shapefile directly using geopandas
    try:
        counties =3D gpd.read_file(url)
        # Filter to get only Richland County, South Carolina
        richland_county =3D counties[(counties["STATEFP"] =3D=3D "45") &amp=
; (counties["COUNTYFP"] =3D=3D "079")]

        # Define the output path for the GeoPackage
        output_path =3D os.path.join(output_directory, f"{output_file_stem}=
.gpkg")
       =20
        # Save the resulting GeoDataFrame to a GeoPackage
        richland_county.to_file(output_path, driver=3D"GPKG")

        print(f"Successfully downloaded and saved Richland County boundary =
data to {output_path}")

    except Exception as e:
