=80
points_gdf =3D gpd.read_file('Data/richland_points_834708_504551.geojson')

# =E2=94=80=E2=94=80 4. AXIS LABELS FROM CRS &amp; DYNAMIC SUBTITLE =E2=94=
=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=
