    "Blue":   {"fill": "#378ADD", "spine": "#C8D8E8", "tick": "#111111"},
    "Green":  {"fill": "#639922", "spine": "#C8E8D0", "tick": "#111111"},
    "Coral":  {"fill": "#D85A30", "spine": "#F0D8C0", "tick": "#111111"},
