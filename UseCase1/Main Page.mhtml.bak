=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=
=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
fig, ax =3D plt.subplots(figsize=3D(12, 8), facecolor=3DFIG_COLOR)
