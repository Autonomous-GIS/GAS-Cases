        "script": "import os\nimport geopandas as gpd\n\ndef download_data():\n    # Define the URL for downloading Richland County, SC boundary from the Census Bureau\n    base_url = \"https://www2.census.gov/geo/tiger/GENZ2021/shp/\"\n    # Year of data\n    year = 2021\n    # State FIPS for South Carolina is 45 and the county FIPS for Richland County is 079\n    file_name = f\"cb_{year}_us_county_500k.zip\"\n    url = base_url + file_name\n\n    # Define the output directory and file name\n    output_directory = \"/home/abk6234/GAS/mysite2/Data\"\n    output_file_stem = \"richland_county_boundary_south_carolina_142777\"\n\n    # Read the zip shapefile directly using geopandas\n    try:\n        counties = gpd.read_file(url)\n        # Filter to get only Richland County, South Carolina\n        richland_county = counties[(counties[\"STATEFP\"] == \"45\") &amp; (counties[\"COUNTYFP\"] == \"079\")]\n\n        # Define the output path for the GeoPackage\n        output_path = os.path.join(output_directory, f\"{output_file_stem}.gpkg\")\n        \n        # Save the resulting GeoDataFrame to a GeoPackage\n        richland_county.to_file(output_path, driver=\"GPKG\")\n\n        print(f\"Successfully downloaded and saved Richland County boundary data to {output_path}\")\n\n    except Exception as e:\n        raise RuntimeError(f\"Failed to download or save data: {e}\")\n\ndownload_data()",
