<body class="bg-zinc-50 text-slate-900" onload="initializeTailwind()">

    <!-- HEADER -->
    <div class="border-b border-slate-200 bg-white sticky top-0 z-50 shadow-sm">
        <div class="max-w-screen-2xl mx-auto px-10 py-5 flex items-center justify-between">
            <div class="flex items-center gap-x-4">
                <div class="w-9 h-9 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-2xl flex items-center justify-center text-white text-2xl shadow-inner">G</div>
                <div>
                    <div class="title-font text-4xl font-semibold tracking-tighter text-slate-900">GAS</div>
                    <div class="text-sm text-slate-500 -mt-1">Geospatial Agentic Services</div>
                </div>
            </div>
            
            <!-- Question + Workflow ID (as subtitle) -->
            <div class="flex-1 max-w-3xl mx-10">
                <div class="bg-white border border-slate-200 rounded-3xl px-8 py-6 shadow-sm">
                    <div class="flex items-center">
                        <span class="text-amber-500 mr-3 text-2xl">📌</span>
                        <span class="font-medium text-slate-700 text-lg">Question</span>
                        <span class="ml-4 text-slate-600 leading-tight">Download the DEM for Richland County, South Carolina, clip it to the Richland County boundary, randomly generate 100 points within the county, extract elevation values for those points, create a histogram of the sampled elevations, and display the generated points on top of the clipped DEM.</span>
                    </div>
                    <div class="flex items-center mt-4 pt-4 border-t border-slate-100 text-xs">
                        <span class="font-medium text-slate-500">Workflow ID</span>
                        <span class="ml-auto font-mono font-semibold text-indigo-600 tracking-widest text-base">wf-54c48b5e-c19d-4e29-ad09-2d0c0850041b</span>
                    </div>
                </div>
            </div>
            
            <div class="flex items-center gap-x-8">
                <div class="text-center">
                    <div class="text-xs text-slate-500 font-medium">ORCHESTRATOR</div>
                    <div class="font-semibold">Coordinator</div>
                </div>
                <div class="h-8 w-px bg-slate-200"></div>
                <div class="flex items-center gap-x-8">
                    <div>
                        <div class="text-xs text-emerald-600">AGENTS</div>
                        <div class="text-3xl font-mono font-semibold">7</div>
                    </div>
                    <div>
                        <div class="text-xs text-emerald-600">TOTAL TIME</div>
                        <div class="text-3xl font-mono font-semibold text-emerald-600">164.77s</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex max-w-screen-2xl mx-auto h-[calc(100vh-73px)]">
    
        <!-- LEFT: Agents -->
        <div class="w-80 bg-white border-r border-slate-200 p-6 flex flex-col shadow-sm">
            <div class="flex justify-between items-baseline mb-6 px-2">
                <h2 class="uppercase text-xs font-semibold tracking-[0.5px] text-slate-500">Pipeline Agents</h2>
            </div>
            <div class="space-y-3 flex-1 overflow-y-auto pr-2">
    
                <div onclick="showAgent(0)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">1</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">DataRetrieverAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Retrieve the DEM for Richland County, South Carolina.</div>
                    </div>
                </div>
        
                <div onclick="showAgent(1)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">2</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">DataRetrieverAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Retrieve the boundary for Richland County, South Carolina.</div>
                    </div>
                </div>
        
                <div onclick="showAgent(2)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">3</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">RasterAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Use the Richland County boundary to clip the DEM, ensuring the output DEM is lim…</div>
                    </div>
                </div>
        
                <div onclick="showAgent(3)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">4</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">VectorAnalysisAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Randomly generate 100 points within the Richland County boundary, ensuring the p…</div>
                    </div>
                </div>
        
                <div onclick="showAgent(4)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">5</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">RasterAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Extract elevation values for each of the 100 randomly generated points using the…</div>
                    </div>
                </div>
        
                <div onclick="showAgent(5)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">6</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">MappingAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Generate a histogram of the elevation values from the 100 sampled points, ensuri…</div>
                    </div>
                </div>
        
                <div onclick="showAgent(6)" class="agent-card cursor-pointer bg-white hover:bg-indigo-50 border border-slate-200 hover:border-indigo-300 rounded-3xl p-5 flex gap-4">
                    <div class="flex-shrink-0 bg-gradient-to-br from-indigo-500 to-violet-500 text-white text-xs font-mono w-8 h-8 rounded-2xl flex items-center justify-center font-semibold shadow-inner">7</div>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg leading-none text-slate-900 mb-2">MappingAgent</div>
                        <div class="text-slate-500 text-sm line-clamp-2">Overlay the 100 randomly generated points on the clipped DEM, ensuring the point…</div>
                    </div>
                </div>
        
            </div>
        </div>
    
        <!-- MIDDLE: Details -->
        <div id="details" class="flex-1 p-10 overflow-y-auto bg-zinc-50">
