        "script": "import geopandas as gpd\nimport rasterio\nimport rasterio.mask\nimport json\n\n# Load Richland County boundary\nboundary_fp = '/home/abk6234/GAS/mysite2/Data/richland_county_boundary_south_carolina_142777.gpkg'\nrichland_county_boundary = gpd.read_file(boundary_fp)\n\n# Load DEM\ndem_fp = '/home/abk6234/GAS/mysite2/Data/richland_county_sc_dem_667377.tif'\ndem = rasterio.open(dem_fp)\n\n# Reproject boundary to match DEM CRS\nboundary = richland_county_boundary.to_crs(dem.crs)\n\n# Convert boundary to GeoJSON format\nboundary_geom = [json.loads(boundary.to_json())['features'][0]['geometry']]\n\n# Clip DEM\nout_image, out_transform = rasterio.mask.mask(dem, boundary_geom, crop=True)\nout_meta = dem.meta.copy()\nout_meta.update({\"driver\": \"GTiff\",\n                 \"height\": out_image.shape[1],\n                 \"width\": out_image.shape[2],\n                 \"transform\": out_transform})\n\n# Save the clipped DEM\nclipped_dem_fp = 'clipped_richland_county_dem.tif'\nwith rasterio.open(clipped_dem_fp, \"w\", **out_meta) as dest:\n    dest.write(out_image)\n\nprint(f\"Clipped DEM saved with CRS: {dem.crs} and bounds: {out_transform}\")",
