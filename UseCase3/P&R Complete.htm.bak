        "script": "import geopandas as gpd\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport matplotlib.colors as mcolors\nfrom matplotlib.colorbar import ColorbarBase\nimport matplotlib\nimport numpy as np\nimport random\nimport mapclassify\nimport os\n\n# \u2500\u2500 1. CONFIG \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nDATA_PATH = \"/home/abk6234/GAS/mysite2/Output/Reproject_the_joined_county_dataset_to_a_034967.geojson\"\nVALUE_COLUMN = \"population_2021\"\nCLASSIFICATION = \"quantiles\"\nK_CLASSES = 5\n\nEDGE_COLOR = \"#C0C0C0\"\nEDGE_WIDTH = 0.15\nBG_COLOR = \"#FFFFFF\"\nFIG_COLOR = \"#FFFFFF\"\nTEXT_COLOR = \"#000000\"\nTITLE = \"Contiguous U.S. Counties by 2021 Population\"\nDPI = 180\n\nrand_num = random.randint(100000, 999999)\nOUTPUT_FILE = f\"/home/abk6234/GAS/mysite2/Output/County_Population_{rand_num}.png\"\n\n# \u2500\u2500 2. COLOR SETS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nCOLOR_SETS = {\n    \"Blues\":   {\"cmap\": \"Blues\",   \"bar_label\": \"#185FA5\", \"spine\": \"#C8D8E8\", \"tick\": \"#111111\"},\n    \"Greens\":  {\"cmap\": \"Greens\",  \"bar_label\": \"#3B6D11\", \"spine\": \"#C8E8D0\", \"tick\": \"#111111\"},\n    \"Oranges\": {\"cmap\": \"Oranges\", \"bar_label\": \"#854F0B\", \"spine\": \"#F0D8C0\", \"tick\": \"#111111\"},\n}\nchosen = COLOR_SETS[\"Blues\"]\nCMAP = chosen[\"cmap\"]\nSPINE_COL = chosen[\"spine\"]\nTICK_COL = chosen[\"tick\"]\n\n# \u2500\u2500 3. LOAD DATA \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ngdf = gpd.read_file(DATA_PATH)\n\nif \"geometry\" not in gdf.columns:\n    raise ValueError(\"Requested map cannot be created because the dataset has no geometry column.\")\n\ngdf = gdf.copy()\ngdf[VALUE_COLUMN] = pd.to_numeric(gdf[VALUE_COLUMN], errors=\"coerce\")\n\ncrs = gdf.crs\n\n# \u2500\u2500 4. AXIS LABELS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nif crs and crs.is_geographic:\n    x_label = \"Longitude (degrees)\"\n    y_label = \"Latitude (degrees)\"\nelse:\n    try:\n        axes = crs.axis_info\n        x_label = f\"{axes[0].name} ({axes[0].unit_name})\"\n        y_label = f\"{axes[1].name} ({axes[1].unit_name})\"\n    except Exception:\n        x_label = \"X\"\n        y_label = \"Y\"\n\ntry:\n    crs_epsg = crs.to_epsg() if crs else None\nexcept Exception:\n    crs_epsg = None\n\nif crs_epsg:\n    crs_str = f\"EPSG:{crs_epsg}\"\nelse:\n    crs_str = crs.to_string() if crs else \"Unknown CRS\"\n\nSUBTITLE = f\"CRS: {crs_str}\"\n\n# \u2500\u2500 5. VALUE PREP \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nvalues = gdf[VALUE_COLUMN]\nvalid_mask = values.notna()\nclean_values = values[valid_mask]\n\nif clean_values.empty:\n    raise ValueError(f\"No valid numeric values in '{VALUE_COLUMN}'\")\n\nvmin, vmax = clean_values.min(), clean_values.max()\n\nunique_count = clean_values.nunique()\nk = min(K_CLASSES, unique_count)\n\nif k &lt; 1:\n    raise ValueError(\"Not enough unique values to classify.\")\n\nif CLASSIFICATION == \"natural_breaks\":\n    classifier = mapclassify.NaturalBreaks(clean_values, k=k)\nelif CLASSIFICATION == \"quantiles\":\n    classifier = mapclassify.Quantiles(clean_values, k=k)\nelif CLASSIFICATION == \"equal_interval\":\n    classifier = mapclassify.EqualInterval(clean_values, k=k)\nelif CLASSIFICATION == \"std_mean\":\n    classifier = mapclassify.StdMean(clean_values)\nelse:\n    raise ValueError(\"Unsupported classification type\")\n\ndiscrete_cmap = matplotlib.colormaps.get_cmap(CMAP).resampled(classifier.k)\n\n# Store colors as hex strings to avoid pandas dtype issues\ngdf[\"_color\"] = \"#D3D3D3\"\nfor idx, cls in zip(clean_values.index, classifier.yb):\n    rgba = discrete_cmap(int(cls))\n    gdf.at[idx, \"_color\"] = mcolors.to_hex(rgba)\n\n# \u2500\u2500 6. FIGURE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfig = plt.figure(figsize=(14, 9), facecolor=FIG_COLOR)\n\nax = fig.add_axes([0.08, 0.18, 0.72, 0.74])\nax.set_facecolor(BG_COLOR)\n\nfor spine in ax.spines.values():\n    spine.set_edgecolor(SPINE_COL)\n    spine.set_linewidth(0.6)\n\nax.tick_params(colors=TICK_COL, labelsize=9)\nax.set_xlabel(x_label, fontsize=10, fontweight=\"bold\", color=TEXT_COLOR)\nax.set_ylabel(y_label, fontsize=10, fontweight=\"bold\", color=TEXT_COLOR)\n\ngdf.plot(\n    ax=ax,\n    color=gdf[\"_color\"].tolist(),\n    edgecolor=EDGE_COLOR,\n    linewidth=EDGE_WIDTH,\n    zorder=2\n)\n\n# \u2500\u2500 7. TITLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nax.set_title(TITLE, fontsize=15, fontweight=\"bold\", loc=\"left\", pad=12, color=TEXT_COLOR)\nfig.text(0.08, 0.02, SUBTITLE, fontsize=10, fontweight=\"bold\", color=TEXT_COLOR)\n\n# \u2500\u2500 8. LEGEND OUTSIDE AXES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ncb_ax = fig.add_axes([0.83, 0.24, 0.035, 0.52])\n\nbounds = np.array(classifier.bins, dtype=float)\nboundaries = np.concatenate(([float(vmin)], bounds))\nnorm = mcolors.BoundaryNorm(boundaries, discrete_cmap.N)\n\ncb = ColorbarBase(\n    cb_ax,\n    cmap=discrete_cmap,\n    norm=norm,\n    boundaries=boundaries,\n    orientation=\"vertical\"\n)\n\ncb_ax.set_title(\"2021 Population\\n(Quantiles)\", fontsize=9, pad=8, color=TEXT_COLOR)\ncb.outline.set_edgecolor(SPINE_COL)\n\ntick_positions = []\ntick_labels = []\nfor i in range(len(boundaries) - 1):\n    lower = boundaries[i]\n    upper = boundaries[i + 1]\n    tick_positions.append((lower + upper) / 2)\n    tick_labels.append(f\"{int(round(lower)):,}\u2013\\n{int(round(upper)):,}\")\n\ncb.set_ticks(tick_positions)\ncb.set_ticklabels(tick_labels)\ncb.ax.tick_params(labelsize=8, colors=TICK_COL)\n\n# \u2500\u2500 9. SAVE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nos.makedirs(os.path.dirname(OUTPUT_FILE), exist_ok=True)\nplt.savefig(OUTPUT_FILE, dpi=DPI, bbox_inches=\"tight\", facecolor=FIG_COLOR)\nprint(f\"__OUTPUT_PATH__={OUTPUT_FILE}\")\nprint(f\"__FEATURE_COUNT__={len(gdf)}\")",
