<!DOCTYPE html>
<!-- saved from url=(0014)about:internet -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GAS • Geospatial Agentic Services</title>
    <script src="./P&amp;R Complete_files/saved_resource"></script>
    <!-- Highlight.js for beautiful Python syntax highlighting -->
    <link rel="stylesheet" href="./P&amp;R Complete_files/github.min.css">
    <script src="./P&amp;R Complete_files/highlight.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap');
        
        body {
            font-family: 'Inter', system_ui, sans-serif;
        }
        .title-font {
            font-family: 'Space Grotesk', sans-serif;
        }
        .agent-card {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .agent-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }
        pre {
            scrollbar-width: thin;
            scrollbar-color: #64748b #f8fafc;
        }
        .hljs {
            background: transparent !important;
            padding: 0 !important;
        }
    </style>
    <script>
        function initializeTailwind() {
            tailwind.config = { content: [], theme: { extend: {} } }
        }
        
        function highlightCode() {
            document.querySelectorAll('#details pre code').forEach((block) => {
                hljs.highlightElement(block);
            });
        }
        
        function showAgent(id) {
            const data = window.agentData[id];
            document.getElementById("details").innerHTML = data;
            highlightCode();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        
        function copyRawJSON() {
            const pre = document.getElementById("raw-json");
            navigator.clipboard.writeText(pre.textContent.trim()).then(() => {
                const original = event.target.innerHTML;
                event.target.innerHTML = '✅ Copied!';
                setTimeout(() => { event.target.innerHTML = original; }, 2000);
            });
        }
        
        function downloadRawJSON() {
            const dataStr = JSON.stringify(window.fullJsonData, null, 2);
            const blob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = "create_a_county_level_choropleth_map_showing_the_2_217.json";
            a.click();
            URL.revokeObjectURL(url);
        }
    </script>
