import json
import geopandas as gpd
import pandas as pd

def download_data():
    # Define the endpoint and related configurations
    base_url =3D "https://api.census.gov/data/2021/acs/acs5"
    api_key =3D "918876e93cf30566c02b367fcad29644d861817e"
    dataset_year =3D "2021"
    dataset_source =3D f"ACS {dataset_year}"

    # Variables needed for total population at the county level
    variables =3D [
        # B01001_001E: Total population
        "B01001_001E"
    ]

    # Fetch variable labels
    response =3D requests.get(f"{base_url}/variables.json")
    variables_metadata =3D response.json()

    # Helper function to get variable labels
    def get_variable_label(var_name):
        label =3D variables_metadata['variables'][var_name]['label']
        return label.replace("Estimate!!", "").strip()

    # Prepare the URL for the data request; no state or county parameter is=
 included in the `for`
    get_vars =3D ",".join(variables)
    url =3D f"{base_url}?get=3D{get_vars}&amp;for=3Dcounty:*&amp;key=3D{api=
_key}"

    # Download data from Census API
    response =3D requests.get(url)
    response.raise_for_status()
    data =3D response.json()

    # Create a DataFrame from the data
    df =3D pd.DataFrame(data[1:], columns=3D[f"{var}:{get_variable_label(va=
r)}" for var in variables] + ["state", "county"])
    df['year'] =3D dataset_year
    df['source'] =3D dataset_source

    # Create column for state and county FIPS as strings with leading zeros
    df['state_fips'] =3D df['state'].apply(lambda x: str(x).zfill(2))
    df['county_fips'] =3D df['county'].apply(lambda x: str(x).zfill(3))
    df['geoid'] =3D df['state_fips'] + df['county_fips']

    # Convert dataframe to a GeoDataFrame
    gdf =3D gpd.GeoDataFrame(df, geometry=3DNone)  # Simply for metadata co=
nversion, no geometries involved

    # Save to GeoJSON
    output_path =3D "/home/abk6234/GAS/mysite2/Data/us_county_868029.geojso=
n"
    gdf.to_file(output_path, driver=3D"GeoJSON")

# Execute the function
download_data()</code></pre></div><div class=3D"px-4 py-2 bg-[#252525] bord=
