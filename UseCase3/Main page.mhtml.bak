=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=
=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
values =3D gdf[VALUE_COLUMN]
valid_mask =3D values.notna()
clean_values =3D values[valid_mask]

if clean_values.empty:
    raise ValueError(f"No valid numeric values in '{VALUE_COLUMN}'")

vmin, vmax =3D clean_values.min(), clean_values.max()

unique_count =3D clean_values.nunique()
k =3D min(K_CLASSES, unique_count)

if k &lt; 1:
    raise ValueError("Not enough unique values to classify.")

if CLASSIFICATION =3D=3D "natural_breaks":
    classifier =3D mapclassify.NaturalBreaks(clean_values, k=3Dk)
elif CLASSIFICATION =3D=3D "quantiles":
    classifier =3D mapclassify.Quantiles(clean_values, k=3Dk)
elif CLASSIFICATION =3D=3D "equal_interval":
    classifier =3D mapclassify.EqualInterval(clean_values, k=3Dk)
elif CLASSIFICATION =3D=3D "std_mean":
    classifier =3D mapclassify.StdMean(clean_values)
else:
    raise ValueError("Unsupported classification type")

discrete_cmap =3D matplotlib.colormaps.get_cmap(CMAP).resampled(classifier.=
k)

# Store colors as hex strings to avoid pandas dtype issues
gdf["_color"] =3D "#D3D3D3"
for idx, cls in zip(clean_values.index, classifier.yb):
    rgba =3D discrete_cmap(int(cls))
    gdf.at[idx, "_color"] =3D mcolors.to_hex(rgba)

# =E2=94=80=E2=94=80 6. FIGURE =E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
