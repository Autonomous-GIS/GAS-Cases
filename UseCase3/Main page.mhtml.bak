import csv
import json

def download_data():
    # Define the endpoint and related configurations
    base_url =3D "https://api.census.gov/data/2021/acs/acs5"
    api_key =3D "918876e93cf30566c02b367fcad29644d861817e"
    dataset_year =3D "2021"
    dataset_source =3D f"ACS {dataset_year}"

    # Variables we need to fetch
    variables =3D [
        # B01001_001E: Total population
        "B01001_001E",
    ]

    # Fetch the variable labels
    response =3D requests.get(f"{base_url}/variables.json")
    variables_metadata =3D response.json()

    # Helper function to get variable labels
    def get_variable_label(var_name):
        label =3D variables_metadata['variables'][var_name]['label']
        return label.replace("Estimate!!", "").strip()

    # Construct the URL for the data request
    get_vars =3D ",".join(variables)
    url =3D f"{base_url}?get=3D{get_vars}&amp;for=3Dcounty:*&amp;key=3D{api=
_key}"

    # Download data from Census API
    response =3D requests.get(url)
    response.raise_for_status()
    data =3D response.json()

    # Prepare the CSV file for writing
    csv_path =3D "/home/abk6234/GAS/mysite2/Data/tabular_2021_418675.csv"

    # Create header with variable labels
    header =3D [f"{var}:{get_variable_label(var)}" for var in variables] + =
["state_fips", "county_fips", "year", "source"]
    rows =3D data[1:]  # Skip the header row provided by API
    for row in rows:
        row.extend([dataset_year, dataset_source])

    # Write to CSV file
    with open(csv_path, mode=3D'w', newline=3D'') as file:
        writer =3D csv.writer(file)
        writer.writerow(header)
        writer.writerows(rows)

# Execute the function
