=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=
=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
cb_ax =3D fig.add_axes([0.83, 0.24, 0.035, 0.52])

bounds =3D np.array(classifier.bins, dtype=3Dfloat)
boundaries =3D np.concatenate(([float(vmin)], bounds))
norm =3D mcolors.BoundaryNorm(boundaries, discrete_cmap.N)

cb =3D ColorbarBase(
    cb_ax,
    cmap=3Ddiscrete_cmap,
    norm=3Dnorm,
    boundaries=3Dboundaries,
    orientation=3D"vertical"
)

cb_ax.set_title("2021 Population\n(Quantiles)", fontsize=3D9, pad=3D8, colo=
r=3DTEXT_COLOR)
cb.outline.set_edgecolor(SPINE_COL)

tick_positions =3D []
tick_labels =3D []
for i in range(len(boundaries) - 1):
    lower =3D boundaries[i]
    upper =3D boundaries[i + 1]
    tick_positions.append((lower + upper) / 2)
    tick_labels.append(f"{int(round(lower)):,}=E2=80=93\n{int(round(upper))=
:,}")

cb.set_ticks(tick_positions)
cb.set_ticklabels(tick_labels)
cb.ax.tick_params(labelsize=3D8, colors=3DTICK_COL)

