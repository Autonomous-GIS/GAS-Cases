mport geopandas as gpd

input_path =3D "/home/abk6234/GAS/mysite2/Data/us_county_889896.geojson"
output_path =3D "/home/abk6234/GAS/mysite2/Data/contiguous_us_counties.geoj=
son"

counties =3D gpd.read_file(input_path)

exclude_stusps =3D {"AK", "HI", "PR", "AS", "GU", "MP", "VI"}
exclude_statefp =3D {"02", "15", "60", "66", "69", "72", "78"}

contiguous_counties =3D counties.loc[
    ~counties["STUSPS"].isin(exclude_stusps) &amp;
    ~counties["STATEFP"].isin(exclude_statefp)
].copy()

contiguous_counties.to_file(output_path, driver=3D"GeoJSON")</code></pre></=
