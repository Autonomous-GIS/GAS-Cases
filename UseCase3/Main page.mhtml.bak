 font-mono text-neutral-300 overflow-x-auto leading-relaxed transition-all =
duration-300"><code>import pandas as pd
import geopandas as gpd

# File paths
counties_path =3D "Data/contiguous_counties_863529_701650.geojson"
population_path =3D "/home/abk6234/GAS/mysite2/Data/tabular_2021_418675.csv=
"
out_path =3D "/home/abk6234/GAS/mysite2/Data/contiguous_counties_population=
_2021_joined.geojson"

# Load data once
counties =3D gpd.read_file(counties_path)
pop =3D pd.read_csv(population_path)

# Keep only 2021 records if a year column exists
if "year" in pop.columns:
    pop =3D pop.loc[pop["year"] =3D=3D 2021].copy()

# Construct standard 5-digit county GEOID from state and county codes
pop["GEOID"] =3D (
    pd.to_numeric(pop["state_fips"], errors=3D"coerce").astype("Int64").ast=
ype(str).str.zfill(2)
    + pd.to_numeric(pop["county_fips"], errors=3D"coerce").astype("Int64").=
astype(str).str.zfill(3)
)

# Ensure population is numeric for later quantile classification
pop["population_2021"] =3D pd.to_numeric(pop["B01001_001E:Total:"], errors=
=3D"coerce")

# Check for duplicate GEOIDs in the population table
dup_count =3D int(pop["GEOID"].duplicated().sum())
print("Duplicate GEOIDs in population table:", dup_count)
if dup_count:
    dup_cols =3D [c for c in ["GEOID", "state_fips", "county_fips", "year"]=
 if c in pop.columns]
    print(pop.loc[pop["GEOID"].duplicated(keep=3DFalse), dup_cols].sort_val=
ues("GEOID").head(20))

# Join population to contiguous county boundaries
join_cols =3D [c for c in ["GEOID", "population_2021", "B01001_001E:Total:"=
, "state_fips", "county_fips", "year", "source"] if c in pop.columns]
result =3D counties.merge(pop[join_cols], on=3D"GEOID", how=3D"left", valid=
ate=3D"1:1")

# Verify join coverage
matched =3D int(result["population_2021"].notna().sum())
unmatched =3D int(result["population_2021"].isna().sum())
print("Boundary counties:", len(result))
print("Matched counties:", matched)
print("Unmatched counties:", unmatched)

if unmatched:
    unmatched_cols =3D [c for c in ["GEOID", "STATEFP", "COUNTYFP", "NAME",=
 "STUSPS", "STATE_NAME"] if c in result.columns]
    unmatched_df =3D result.loc[result["population_2021"].isna(), unmatched=
_cols].copy()
    print("Unmatched county examples:")
    print(unmatched_df.head(20))
else:
    print("Join coverage is complete for contiguous counties.")

# Check for population-table counties not present in the contiguous boundar=
y layer
extra_tabular =3D sorted(set(pop["GEOID"]) - set(counties["GEOID"]))
print("Population table GEOIDs not in contiguous boundary layer:", len(extr=
a_tabular))
if extra_tabular:
    extra_cols =3D [c for c in ["GEOID", "state_fips", "county_fips", "popu=
lation_2021", "year", "source"] if c in pop.columns]
    print(pop.loc[pop["GEOID"].isin(extra_tabular), extra_cols].head(20))

# Confirm numeric dtype
print(result[["GEOID", "population_2021"]].dtypes)

# Write output
result.to_file(out_path, driver=3D"GeoJSON")
print("Wrote GeoJSON to:", out_path)</code></pre></div><div class=3D"px-4 p=
