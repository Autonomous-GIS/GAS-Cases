=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
if crs and crs.is_geographic:
    x_label =3D "Longitude (degrees)"
    y_label =3D "Latitude (degrees)"
else:
    try:
        axes =3D crs.axis_info
        x_label =3D f"{axes[0].name} ({axes[0].unit_name})"
        y_label =3D f"{axes[1].name} ({axes[1].unit_name})"
    except Exception:
        x_label =3D "X"
        y_label =3D "Y"

try:
    crs_epsg =3D crs.to_epsg() if crs else None
except Exception:
    crs_epsg =3D None

if crs_epsg:
    crs_str =3D f"EPSG:{crs_epsg}"
else:
    crs_str =3D crs.to_string() if crs else "Unknown CRS"

SUBTITLE =3D f"CRS: {crs_str}"

# =E2=94=80=E2=94=80 5. VALUE PREP =E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=
=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
