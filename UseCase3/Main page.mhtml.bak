=E2=94=80=E2=94=80=E2=94=80
fig =3D plt.figure(figsize=3D(14, 9), facecolor=3DFIG_COLOR)

ax =3D fig.add_axes([0.08, 0.18, 0.72, 0.74])
ax.set_facecolor(BG_COLOR)

for spine in ax.spines.values():
    spine.set_edgecolor(SPINE_COL)
    spine.set_linewidth(0.6)

ax.tick_params(colors=3DTICK_COL, labelsize=3D9)
ax.set_xlabel(x_label, fontsize=3D10, fontweight=3D"bold", color=3DTEXT_COL=
OR)
ax.set_ylabel(y_label, fontsize=3D10, fontweight=3D"bold", color=3DTEXT_COL=
OR)

