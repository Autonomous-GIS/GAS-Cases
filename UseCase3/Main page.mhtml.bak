=E2=94=80=E2=94=80=E2=94=80
DATA_PATH =3D "/home/abk6234/GAS/mysite2/Output/Reproject_the_joined_county=
_dataset_to_a_034967.geojson"
VALUE_COLUMN =3D "population_2021"
CLASSIFICATION =3D "quantiles"
