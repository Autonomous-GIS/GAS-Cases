import geopandas as gpd

# Define a function to download US county boundaries from the Census Bureau
def download_data():
    # URL for the US county boundaries from the Census Bureau for the year =
2021
    url =3D "https://www2.census.gov/geo/tiger/GENZ2021/shp/cb_2021_us_coun=
ty_500k.zip"
   =20
    # Use Geopandas to read the file directly from the URL
    gdf =3D gpd.read_file(url)
   =20
    # Define the directory and filename to save the final dataset
    output_path =3D "/home/abk6234/GAS/mysite2/Data/us_county_889896.geojso=
n"

    # Save the geospatial data in GeoJSON format
    gdf.to_file(output_path, driver=3D"GeoJSON")

# Execute the download_data function to perform the download and save opera=
tion
download_data()</code></pre></div><div class=3D"px-4 py-2 bg-[#252525] bord=
