=80
gdf =3D gpd.read_file(DATA_PATH)

if "geometry" not in gdf.columns:
    raise ValueError("Requested map cannot be created because the dataset h=
as no geometry column.")

gdf =3D gdf.copy()
gdf[VALUE_COLUMN] =3D pd.to_numeric(gdf[VALUE_COLUMN], errors=3D"coerce")

crs =3D gdf.crs

# =E2=94=80=E2=94=80 4. AXIS LABELS =E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=
=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
